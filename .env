# docker-compose.yml内で利用する環境変数の設定
COMPOSE_PROJECT_NAME=project1           # プロジェクト名(全て小文字)
CONTAINER_NAME=Docker_Linux

Dockerfile_DIR=.
Dockerfile=Dockerfile

VOLUME=./linux_data

TIME_ZONE=Asia/Tokyo
LANG=ja_JP.UTF8

NETWORK_NAME=ethd
IP_SUBNET_ADDR=192.168.1.0
IP_PREFIX=24
IP_GATEWAY_ADDR=192.168.1.1

USER_NAME=PEN
PASSWORD=password

ENTRY_DIR=Programs
ENTRY_POINT=start.sh

WS=WS

# EMQXのバージョン指定
# Default : start.sh内のハードコード設定のまま(フォーク版を使用)
# Latest  : GitHubから最新タグを取得してビルド
# X.Y.Z   : 指定バージョン(例: 5.8.0)。未知のバージョンはDefaultにフォールバック
VERSION=6.2.0
